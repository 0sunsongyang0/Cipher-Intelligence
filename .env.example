# Copy this file to `backend/.env` for a persistent campus-network deployment.
APP_ENV=production
# Deprecated compatibility setting. Local account login is disabled; use Casdoor SSO.
APP_ACCESS_PASSWORD=replace-with-campus-password
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
DEEPSEEK_API_KEY=replace-with-owner-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
SMART_MODEL_ROUTING_ENABLED=true
SMART_MODEL_ROUTING_ECONOMY_MODEL=deepseek-v4-flash
SMART_MODEL_ROUTING_STRONG_MODEL=deepseek-v4-pro
# Optional: override the default DeepSeek-compatible API endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional real web search support used by the manual search toggle.
SEARCH_PROVIDER=tavily
SEARCH_RESULT_LIMIT=5
SEARCH_TIMEOUT_SECONDS=12
TAVILY_API_KEY=your-tavily-api-key
TAVILY_SEARCH_DEPTH=advanced
TAVILY_NEWS_TIME_RANGE=day
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
MISP_URL=
MISP_API_KEY=
# Server-only IOC provider configuration. Never expose this value through Vite variables.
# Each provider supports: enabled, apiKey, baseUrl, timeoutSeconds, rateLimitPerMinute,
# cacheTtlSeconds and staleTtlSeconds. Custom HTTP URLs may use {type}/{value}; headers
# may use {api_key}. Custom responses use confidence, malicious, tags, externalUrl, updatedAt.
IOC_PROVIDER_CONFIG_JSON={"virustotal":{"enabled":false,"apiKey":"","baseUrl":"https://www.virustotal.com","timeoutSeconds":10,"rateLimitPerMinute":4,"cacheTtlSeconds":3600,"staleTtlSeconds":86400},"abuseipdb":{"enabled":false,"apiKey":"","baseUrl":"https://api.abuseipdb.com"},"otx":{"enabled":false,"apiKey":"","baseUrl":"https://otx.alienvault.com"},"misp":{"enabled":false,"apiKey":"","baseUrl":"https://misp.example.com"},"greynoise":{"enabled":false,"apiKey":"","baseUrl":"https://api.greynoise.io"},"custom-soc":{"enabled":false,"apiKey":"","baseUrl":"https://intel.example/api/ioc/{type}/{value}","headers":{"Authorization":"Bearer {api_key}"}}}
# Leave DATABASE_URL unset to use the built-in backend/data/app.db path.
# DATABASE_URL=sqlite:///./data/app.db
# Internal cost of one newly submitted CAPE task, in CNY, normalized into the USD budget ledger.
CAPE_TASK_COST_CNY=1
BILLING_CNY_PER_USD=7.2
# Legacy override in micro-USD. A value greater than 0 takes precedence over CAPE_TASK_COST_CNY.
CAPE_TASK_COST_MICROUSD=0

# Casdoor OAuth 2.0 / OIDC single sign-on. Keep the client secret on the backend.
# Add both callback URLs to the Casdoor application's Redirect URLs list:
#   https://chat.example.invalid/api/auth/casdoor/callback
#   https://admin.example.invalid/api/auth/casdoor/callback
CASDOOR_ENABLED=false
CASDOOR_ENDPOINT=https://door.example.com
# Optional same-host API address; keeps trusted server calls away from public CAPTCHA.
CASDOOR_INTERNAL_ENDPOINT=http://127.0.0.1:7001
CASDOOR_CLIENT_ID=replace-with-casdoor-application-client-id
CASDOOR_CLIENT_SECRET=replace-with-casdoor-application-client-secret
CASDOOR_ORGANIZATION_NAME=replace-with-casdoor-organization-name
CASDOOR_APPLICATION_NAME=replace-with-casdoor-application-name
CASDOOR_APPLICATION_OWNER=admin
CASDOOR_DISPLAY_NAME=Cipher SSO
CASDOOR_SCOPE=openid profile email
CASDOOR_REDIRECT_URI=https://chat.example.invalid/api/auth/casdoor/callback
CASDOOR_ADMIN_REDIRECT_URI=https://admin.example.invalid/api/auth/casdoor/callback
# New Casdoor identities become local Cipher users automatically.
CASDOOR_AUTO_CREATE_USERS=true
# Keep false by default to prevent silently taking over an existing local username.
CASDOOR_AUTO_LINK_USERS=false
# Comma-separated Casdoor username, subject or email values allowed into Cipher Admin.
CASDOOR_ADMIN_USERS=replace-with-admin-username
# Optional comma-separated roles if your Casdoor UserInfo response exposes role claims.
CASDOOR_ADMIN_ROLES=
CASDOOR_ROLE_MAPPING={"cipher-owner":"owner","cipher-admin":"admin","soc-analyst":"analyst","soc-reviewer":"reviewer","cipher-viewer":"viewer"}
CASDOOR_SYNC_GROUPS_AS_WORKSPACES=true
# Enable only after Casdoor plans/subscriptions have been configured. When on,
# an active Casdoor subscription becomes the source of truth for the Cipher tier.
CASDOOR_COMMERCE_ENABLED=false
# Optional JSON overrides; monthly/yearly suffixes are recognized automatically.
CASDOOR_PLAN_TIER_MAPPING={"cipher-free":"free","cipher-standard":"standard","cipher-pro":"pro","cipher-enterprise":"enterprise"}
CASDOOR_TIMEOUT_SECONDS=15
# Optional: move normalized profile avatars outside backend/data/avatars.
# AVATAR_STORAGE_PATH=/var/lib/cipher/avatars
# Data retention (days; 0 keeps the domain indefinitely). Admin UI/API can override these values.
RETENTION_CLEANUP_INTERVAL_SECONDS=86400
RETENTION_UPLOAD_DAYS=30
# Never put API tokens, passwords, or encryption keys in this example or in backup archives.
