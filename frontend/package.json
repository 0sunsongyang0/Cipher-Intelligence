{
  "name": "cipher-desktop",
  "private": true,
  "version": "2.1.1",
  "description": "Cipher desktop client",
  "author": {
    "name": "Cipher",
    "email": "cipher@example.invalid"
  },
  "homepage": "https://cipher.example.invalid",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "material-file-icons": "^2.4.0",
    "mathjax": "^4.1.3",
    "mathjax-full": "^3.2.1",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "rehype-mathjax": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^25.0.1",
    "wait-on": "^8.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "build": {
    "appId": "com.cipher.desktop",
    "productName": "Cipher",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libnss3",
        "libatk-bridge2.0-0",
        "libgtk-3-0",
        "libgbm1",
        "libasound2",
        "libxss1",
        "libx11-xcb1",
        "libxcomposite1",
        "libxdamage1",
        "libxrandr2",
        "libxtst6"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
